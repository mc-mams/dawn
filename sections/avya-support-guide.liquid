{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="avya-section__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="avya-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h1">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <ul class="avya-levels">
      {%- for block in section.blocks -%}
        {%- assign level = block.settings.level | plus: 0 -%}
        <li
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            class="scroll-trigger animate--slide-in"
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          <a
            class="avya-level"
            href="{% if block.settings.link != blank %}{{ block.settings.link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
          >
            <span class="avya-support" aria-hidden="true">
              <span class="avya-support__bars">
                {%- for i in (1..3) -%}
                  <span class="avya-support__bar{% if i <= level %} is-on{% endif %}"></span>
                {%- endfor -%}
              </span>
            </span>
            <h3 class="avya-level__name h2">{{ block.settings.name | escape }}</h3>
            <p class="avya-level__text">{{ block.settings.text | escape }}</p>
            <span class="avya-level__cta">{{ block.settings.cta | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "AVYA – Guide du maintien",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Trouver votre maintien" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Trois niveaux, une silhouette" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Choisissez d'abord l'effet recherché, puis le modèle. Chaque body indique son niveau de maintien."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 64 }
  ],
  "blocks": [
    {
      "type": "level",
      "name": "Niveau",
      "settings": [
        { "type": "text", "id": "name", "label": "Nom", "default": "Léger" },
        {
          "type": "select",
          "id": "level",
          "label": "Barres remplies",
          "options": [
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" }
          ],
          "default": "1"
        },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Lisse et unifie, pour tous les jours." },
        { "type": "text", "id": "cta", "label": "Texte du lien", "default": "Découvrir" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AVYA – Guide du maintien",
      "blocks": [
        { "type": "level", "settings": { "name": "Léger", "level": "1" } },
        { "type": "level", "settings": { "name": "Modéré", "level": "2" } },
        { "type": "level", "settings": { "name": "Ferme", "level": "3" } }
      ]
    }
  ]
}
{% endschema %}

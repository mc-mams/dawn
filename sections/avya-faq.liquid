{%- comment -%}
  AVYA — FAQ à onglets. Chaque question a une catégorie ; les onglets sont les catégories,
  dans l'ordre où elles apparaissent. Sans JavaScript, toutes les catégories s'affichent
  l'une sous l'autre (assets/avya-faq.js active les onglets).
{%- endcomment -%}

{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign categories = ''
  for block in section.blocks
    assign cat = block.settings.category | strip
    unless categories contains cat
      if categories == ''
        assign categories = cat
      else
        assign categories = categories | append: '||' | append: cat
      endif
    endunless
  endfor
  assign category_list = categories | split: '||'
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="avya-faq" data-avya-faq>
      <div class="avya-faq__header">
        {%- if section.settings.caption != blank -%}
          <p class="caption-with-letter-spacing">{{ section.settings.caption | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h1">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>

      <div class="avya-faq__tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}" hidden>
        {%- for category in category_list -%}
          <button
            type="button"
            class="avya-faq__tab"
            role="tab"
            id="faq-tab-{{ section.id }}-{{ forloop.index }}"
            aria-controls="faq-panel-{{ section.id }}-{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          >
            {{- category | escape -}}
          </button>
        {%- endfor -%}
      </div>

      {%- for category in category_list -%}
        <div
          class="avya-faq__panel"
          role="tabpanel"
          id="faq-panel-{{ section.id }}-{{ forloop.index }}"
          aria-labelledby="faq-tab-{{ section.id }}-{{ forloop.index }}"
        >
          <h3 class="avya-faq__category h4">{{ category | escape }}</h3>
          {%- for block in section.blocks -%}
            {%- if block.settings.category == category -%}
              <div class="accordion" {{ block.shopify_attributes }}>
                <details>
                  <summary>
                    <div class="summary__title">
                      <h4 class="accordion__title h5">{{ block.settings.question | escape }}</h4>
                    </div>
                    {{- 'icon-caret.svg' | inline_asset_content -}}
                  </summary>
                  <div class="accordion__content rte">{{ block.settings.answer }}</div>
                </details>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<script src="{{ 'avya-faq.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "AVYA – FAQ à onglets",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "caption", "label": "Sur-titre", "default": "Questions fréquentes" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Tout savoir avant de choisir" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Palette de couleurs", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge haute", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Marge basse", "default": 56 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "category", "label": "Catégorie (onglet)", "info": "Les questions de même catégorie sont regroupées dans un onglet." },
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Réponse" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AVYA – FAQ à onglets",
      "blocks": [{ "type": "question" }]
    }
  ]
}
{% endschema %}

{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "square"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "badge": {
          "type": "text",
          "settings": {
            "text": "AVYA",
            "text_style": "uppercase"
          }
        },
        "support": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'avya-support-level', product: product, style: 'full' %}"
          }
        },
        "size_tip": {
          "type": "text",
          "settings": {
            "text": "Entre deux tailles ? Choisissez la plus grande.",
            "text_style": "subtitle"
          }
        },
        "tab_size": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Guide des tailles",
            "icon": "ruler",
            "content": "<p><strong>Tour de taille</strong> : mesurez au point le plus fin, ruban à plat, sans serrer.</p><p><strong>Tour de hanches</strong> : mesurez au point le plus large.</p><p><strong>Tour de poitrine</strong> : mesurez à hauteur de pointe, en soutien-gorge non rembourré.</p><p>Reportez ensuite vos mesures dans le tableau du modèle.</p>"
          }
        },
        "tab_material": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Composition et entretien",
            "icon": "washing",
            "content": "<p>Composition : à compléter.</p><p>Lavage à 30 °C dans un filet, sans adoucissant. Séchage à plat.</p>"
          }
        },
        "tab_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Livraison et retours",
            "icon": "truck",
            "content": "<p>Livraison suivie en 10 jours ouvrés environ. Le numéro de suivi vous est envoyé par e-mail dès l'expédition.</p><p>Les conditions de retour et de remboursement sont détaillées dans notre politique de retour.</p>"
          }
        }
      },
      "block_order": [
        "badge",
        "title",
        "price",
        "support",
        "variant_picker",
        "size_tip",
        "quantity_selector",
        "buy_buttons",
        "description",
        "tab_size",
        "tab_material",
        "tab_shipping"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": false,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 24,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "À porter avec",
        "heading_size": "h1",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "sticky_atc": {
      "type": "avya-sticky-atc",
      "settings": {
        "color_scheme": "scheme-1"
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products",
    "sticky_atc"
  ]
}
      "type": "collapsible-content",
      "blocks": {
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Comment choisir ma taille ?",
            "icon": "ruler",
            "row_content": "<p>Mesurez votre tour de taille et de hanches, puis reportez-vous au guide des tailles de chaque modèle. Entre deux tailles, prenez la plus grande pour plus de confort.</p>"

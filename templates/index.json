          "type": "collapsible_row",
          "settings": {
            "heading": "Livraison et retours",
            "icon": "truck",
            "row_content": "<p>Commande expédiée sous 48 h avec suivi. Retours possibles sous 30 jours, article non porté et dans son emballage d'origine.</p>"

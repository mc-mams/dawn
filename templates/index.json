          "type": "collapsible_row",
          "settings": {
            "heading": "Comment l'entretenir ?",
            "icon": "washing",
            "row_content": "<p>Lavage à la main ou en machine à 30 °C dans un filet, sans adoucissant. Séchage à plat, à l'abri du soleil.</p>"
